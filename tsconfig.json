{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"verbatimModuleSyntax": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist",
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"sourceMap": true,
		"noEmitOnError": true,
		"types": ["node", "vscode"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "node_modules", "test"]
}
