{
	"name": "vscode-schema-intellisense",
	"version": "0.0.1",
	"description": "JSON-Schema-driven IntelliSense for template variables",
	"main": "./dist/extension.js",
	"displayName": "Schema IntelliSense for Templates",
	"publisher": "reinsbrain",
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test test/unit/**/*.test.ts",
		"build": "tsc -p .",
		"watch": "tsc -w -p .",
		"lint": "tsc -p . --noEmit",
		"vscode:prepublish": "npm run build"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"json-schema",
		"eta",
		"intellisense",
		"template",
		"vscode-extension"
	],
	"author": "Rein Petersen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ReinsBrain/vscode-schema-intellisense.git"
	},
	"homepage": "https://github.com/ReinsBrain/vscode-schema-intellisense#readme",
	"bugs": {
		"url": "https://github.com/ReinsBrain/vscode-schema-intellisense/issues"
	},
	"type": "module",
	"engines": {
		"node": ">=24",
		"vscode": "^1.95.0"
	},
	"activationEvents": [
		"onLanguage:eta",
		"onStartupFinished"
	],
	"contributes": {
		"configuration": {
			"title": "Template Schema IntelliSense",
			"properties": {
				"templateSchemaIntellisense.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable JSON-Schema-driven template IntelliSense."
				},
				"templateSchemaIntellisense.languageIds": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"eta"
					],
					"description": "Language IDs that should receive schema IntelliSense."
				},
				"templateSchemaIntellisense.maxHeaderLines": {
					"type": "number",
					"default": 30,
					"minimum": 1,
					"description": "Maximum header lines to scan for @schema pragma."
				},
				"templateSchemaIntellisense.pragmaTag": {
					"type": "string",
					"default": "@schema",
					"description": "Pragma tag used to declare schema file."
				},
				"templateSchemaIntellisense.defaultRoot": {
					"type": "string",
					"default": "$",
					"description": "Default root variable when @root is omitted."
				}
			}
		}
	},
	"devDependencies": {
		"@types/node": "^25.7.0",
		"@types/vscode": "^1.118.0",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"ajv": "^8.20.0"
	}
}
